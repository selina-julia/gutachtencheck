# Stripe Sandbox. Schlüssel aus dem Stripe-Dashboard im Testmodus:
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Signing Secret des Webhook-Endpunkts. Lokal von `stripe listen` ausgegeben,
# in der Cloud aus dem Dashboard unter Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...

# Basis-URL für die Rückkehr aus dem Stripe-Checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend. API-Schlüssel aus https://resend.com/api-keys
RESEND_API_KEY=re_...

# Absender. Die Domain muss in Resend verifiziert sein.
RESEND_FROM=Gutachtencheck <noreply@gutachtencheck.online>

# Adresse, an die die interne Benachrichtigung über neue Bestellungen geht.
BETREIBER_EMAIL=

# Supabase. Projekt-URL und Schlüssel aus den Projekteinstellungen.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Schützt den geplanten Aufräum-Aufruf. Beliebige lange Zufallszeichenfolge.
CRON_SECRET=

# Adressen mit Zugang zur Verwaltung unter /admin, kommagetrennt.
ADMIN_EMAILS=
